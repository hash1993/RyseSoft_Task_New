MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 861427614}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a952ff0a6afde7c4b95d55801086887e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Name: Sparkles - Loop
  Category: 
  DefaultSelected: 1
  AlignViewToTransform: 1
  image: {fileID: 0}
  ObjectsToToggle: []
  Description: This Scene displays a simple Sparkle Burst, looping effect, that syncrhonizes
    a flashing light and a random sound every time a spark burst is spawned.
  Tags: 
  Priority: 0
  Sections:
  - SectionName: 'Scripted Prefab : Basics and VFX'
    image: {fileID: 0}
    SectionContent: 'In order to perform a sparkle burst, a random delay is computed
      : upon expiration of the delay, a "OnPlay" Event is sent to the Visual Effect
      Component. It is consumed by the graph to spawn a burst of sparkles. '
    Actions:
    - Description: Prefab Root (Script Base)
      Target: {fileID: 1423870235}
    - Description: VFX Component
      Target: {fileID: 1423870238}
    - Description: VFX Asset
      Target: {fileID: 8926484042661614526, guid: 136ee4ff3a712604399c01bf3929873f, type: 3}
  - SectionName: Spotlight Flash
    image: {fileID: 0}
    SectionContent: 'At the same time the VFX event is sent, the main script enables
      a spotlight. Upon enabling itself, the spotlight triggers a delay before disabling
      itself:


      On Enable Event > Delayed Logic > Toggle  Game Object Action'
    Actions:
    - Description: Spotlight
      Target: {fileID: 1423870237}
  - SectionName: 'Audio : Random Sparkle Sound'
    image: {fileID: 0}
    SectionContent: Alongside this event, the AudioSource is requested to play a
      spark sound picked at random from a list (Play Random Clip Action)
    Actions:
    - Description: Audio Source
      Target: {fileID: 1423870236}
